# Get both from your Supabase project: Project Settings -> Database -> Connection string
#
# DATABASE_URL — the pooler (Supavisor), used at runtime and during `next build`
#   (the homepage queries the DB at build time to prerender).
#   - Transaction pooler (port 6543): the recommended default. Add
#     pgbouncer=true (disables prepared statements, required since each
#     query may land on a different backend connection in transaction
#     mode) and a connection_limit — 1 is too low in practice (Prisma's own
#     client-side pool will time out under any concurrent load, e.g. two
#     admin dashboard queries firing at once); 5 has worked well.
#   - Session pooler (port 5432): an alternative if the transaction pooler
#     isn't reachable from your network, with connection_limit=1. Has been
#     unreliable in this project (intermittent "can't reach database
#     server" even though the port is open) — prefer transaction mode.
#
# DIRECT_URL — a direct (non-pooled) connection, used by `prisma migrate`/
#   `db push` for schema changes. The true direct connection
#   (db.xxxxxxxxxxxx.supabase.co:5432) is IPv6-only unless your Supabase
#   project has the IPv4 add-on, and is not reachable from every network.
#   The transaction pooler works for `prisma migrate resolve` but NOT for
#   `db push`/`migrate dev` themselves — those need the shadow-database/
#   schema-diffing machinery, which conflicts with pgbouncer's prepared
#   statements ("prepared statement already exists"). If that happens,
#   apply the DDL manually (e.g. `prisma.$executeRawUnsafe(...)` with the
#   ALTER TABLE statement), write the migration/[timestamp]_name/
#   migration.sql file by hand to match, then run
#   `prisma migrate resolve --applied <name>` to reconcile history.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres"
SESSION_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAIL="admin@example.org"
ADMIN_PASSWORD="set-a-strong-password"
NEXT_PUBLIC_GOOGLE_FORM_URL="https://docs.google.com/forms/d/e/1FAIpQLSc_oi2h942OqEw3U3TKiHjQsBJ2rcR5GZ6CuDUPxXZel7jYAg/viewform"
NEXT_PUBLIC_EVENT_DATE="2027-05-13T09:00:00+08:00"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# From resend.com — used to email a participant when an admin confirms their
# registration. Without a key set, confirmation just logs a warning and skips
# the email (never blocks the status update). The default "from" address only
# works for sending to the Resend account's own verified email until you
# verify a sending domain in the Resend dashboard.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="APRRC 2027 <onboarding@resend.dev>"
