# Get both from your Supabase project: Project Settings -> Database -> Connection string
#
# DATABASE_URL — the pooler (Supavisor), used at runtime and during `next build`
#   (the homepage queries the DB at build time to prerender). ALWAYS include
#   connection_limit=1 — Supabase's pooler already pools connections, and
#   without this Prisma opens its own multi-connection pool on top of that
#   and can exhaust the pooler's client cap (build fails with
#   "max clients reached in session mode").
#   - Transaction pooler (port 6543): also add pgbouncer=true (disables
#     prepared statements, required since each query may land on a
#     different backend connection in transaction mode).
#   - Session pooler (port 5432): connection_limit=1 is enough.
#     Use this one if the direct connection / transaction pooler aren't
#     reachable from your network (session pooler is IPv4-compatible).
#
# DIRECT_URL — a direct (non-pooled) connection, used only by `prisma migrate`.
#   Only reachable over IPv6 unless your Supabase project has the IPv4
#   add-on; if `prisma migrate` can't connect, point this at the session
#   pooler too (same host as DATABASE_URL, no query params needed).
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres"
SESSION_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAIL="admin@example.org"
ADMIN_PASSWORD="set-a-strong-password"
NEXT_PUBLIC_GOOGLE_FORM_URL="https://docs.google.com/forms/d/e/1FAIpQLSc_oi2h942OqEw3U3TKiHjQsBJ2rcR5GZ6CuDUPxXZel7jYAg/viewform"
NEXT_PUBLIC_EVENT_DATE="2027-05-13T09:00:00+08:00"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# From resend.com — used to email a participant when an admin confirms their
# registration. Without a key set, confirmation just logs a warning and skips
# the email (never blocks the status update). The default "from" address only
# works for sending to the Resend account's own verified email until you
# verify a sending domain in the Resend dashboard.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="APRRC 2027 <onboarding@resend.dev>"
