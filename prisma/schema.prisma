generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ParticipantStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REJECTED
}

model Participant {
  id                 String @id @default(cuid())
  registrationNumber String @unique

  // Personal details — firstName/lastName/email/phone/country are the only
  // fields required at the DB level, since admin manual-add and CSV import
  // don't collect the full registration-form field set. The public
  // registration form enforces its own stricter "required" rules via Zod.
  firstName       String
  middleName      String?
  lastName        String
  gender          String?
  dateOfBirth     DateTime?
  country         String // nationality — also used for the public "countries represented" stats
  countryCode     String
  passportNumber  String?
  rotaryId        String?
  district        String? // Rotary/Rotaract District Number
  organization    String? // Club Name
  position        String? // Club Position
  email           String
  phone           String?
  alternatePhone  String?
  facebookAccount String?
  whatsapp        String?
  instagram       String?
  shirtSize       String?

  // Emergency contact
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?
  emergencyContactEmail        String?

  // Additional information
  dietaryRestrictions String?
  medicalConditions   String?
  specialAssistance   String?

  // Payment
  paymentMethod          String?
  proofOfPayment         Bytes?
  proofOfPaymentMimeType String?
  proofOfPaymentFileName String?

  city             String?
  status           ParticipantStatus @default(PENDING)
  adminNotes       String?
  registrationDate DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status])
  @@index([country])
  @@index([registrationDate])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}
